{#- The intro letter: a short signed note on a dark block with a thin frame. Its small label is repeated upside down at the bottom. -#}
<section class="letter" aria-labelledby="letter-label">
  <h2 class="letter__label" id="letter-label">{{ home.letter.label }}</h2>
  <div class="letter__text">
    {%- for paragraph in home.letter.paragraphs %}
    <p>{{ paragraph | safe }}</p>
    {%- endfor %}
  </div>
  <p class="letter__label letter__label--mirrored" aria-hidden="true">{{ home.letter.label }}</p>
</section>
