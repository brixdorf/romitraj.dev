{#-
  The hero: the opening serif line, the giant headline, the outlined italic words over it, the large
  serif word, the picture frame, the status ticker, the navigation lists and the short introduction.
  The four headline pieces are for the eye only. Screen readers get the whole sentence from the hidden h1.
-#}
<section class="hero" style="--opening-em: {{ textWidths.opening }}; --giant-em: {{ textWidths.giant }}; --giant-line-em: {{ textWidths.giantLongestLine }}; --giant-first-line-em: {{ textWidths.giantFirstLine }}; --serif-em: {{ textWidths.serif }};">
  <h1 class="visually-hidden">{{ headline.full }}</h1>

  <p class="hero__opening" aria-hidden="true" data-fit="opening">{{ headline.opening.plain }} <em>{{ headline.opening.italic }}</em></p>

  <p class="hero__giant" aria-hidden="true" data-fit="giant">
    {%- for line in headline.giant %}<span class="hero__giant-line">{{ line | raisedApostrophe | safe }}</span>{% if not loop.last %} {% endif %}{% endfor -%}
  </p>
  <p class="hero__flourish" aria-hidden="true">{{ headline.flourish }}</p>
  <p class="hero__serif" aria-hidden="true" data-fit="serif">{{ headline.serif }}</p>

  <p class="hero__lead">{{ home.lead | safe }}</p>
  <p class="hero__note">{{ home.scrollNote }}</p>

  <div class="hero__image">
    <p class="hero__image-note">{{ home.imageNote }}</p>
  </div>

  {%- include "partials/ticker.njk" %}

  <nav class="hero__nav" aria-label="Main">
    {%- for group in navigation %}
    <p class="nav-list__label" id="nav-{{ group.label | slugify }}">{{ group.label }}</p>
    <ul class="nav-list" aria-labelledby="nav-{{ group.label | slugify }}">
      {%- for item in group.items %}
      <li><a class="nav-list__link" href="{{ item.url }}"><span class="nav-list__title">{{ item.title }}</span> <span class="nav-list__hint"><span class="dash" aria-hidden="true"></span> {{ item.hint }}</span></a></li>
      {%- endfor %}
    </ul>
    {%- endfor %}
  </nav>
</section>
