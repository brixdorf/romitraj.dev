---
layout: layouts/base.njk
---
{#- A short notice page, used for pages that are not written yet: a label, the page name, one or two sentences and a way home. -#}
<section class="notice">
  <p class="notice__label">{{ site.url | replace("https://", "") }} / {{ label or "coming soon" }}</p>
  <h1 class="notice__title">{{ title }}</h1>
  <div class="notice__text">
    {{ content | safe }}
  </div>
  <p class="notice__home"><a class="link" href="/">&larr; Go home</a></p>
</section>
