---
title: About
heading: About the human
headingSize: long
frame: square
picture: compass
frameTone: ink
ruled: true
layout: layouts/page.njk
description: Who Romit Raj Sahu is, what he is experimenting with, and how to reach him.
---
{#-
  The About page: a grid of cards and picture frames. All of its words are in _data/about.json.
  Each card and frame is marked data-part="card": during a page change they arrive one after another, in this order.
-#}
{%- from "partials/icon.njk" import icon with context -%}
{%- macro arrow(url) %}<span class="link__arrow" aria-hidden="true">{% if "http" in url or "mailto:" in url %}&nearr;{% else %}&rarr;{% endif %}</span>{% endmacro -%}
{#- The piece about the latest blog post. The data-... marks are for the script that brings it up to date. #}
{%- macro latestPost(post) %}
  <article class="teaser about-page__latest" data-part="card" data-latest-post>
    <p class="teaser__meta">{{ about.latest.label }}, <time datetime="{{ post.isoDate }}" data-post-date>{{ post.date }}</time></p>
    <h3 class="teaser__title" data-post-title>{{ post.title }}</h3>
    {%- if post.description %}
    <p class="teaser__text" data-post-text>{{ post.description }}</p>
    {%- endif %}
    <a class="teaser__link" href="{{ post.url }}" data-post-link>{{ about.latest.link }}{{ arrow(post.url) }}</a>
  </article>
{%- endmacro -%}
<div class="page-grid about-page" data-part="cards">
  <section class="panel about-page__who" data-part="card">
    <h2 class="panel__title">{{ about.who.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in about.who.paragraphs %}
      <p>{{ paragraph | fill | safe }}</p>
      {%- endfor %}
    </div>
    <p class="panel__links">
      {%- for item in about.who.links %}
      <a href="{{ item.url }}">{{ item.title }}{{ arrow(item.url) }}</a>
      {%- endfor %}
    </p>
  </section>

  <figure class="about-page__portrait" data-part="card">
    {#- The photo's shown width, for the browser to pick a file: a square of at most 224px below
        1000px, two of the twelve columns from there (about-page.css). #}
    <div class="frame about-page__portrait-frame">{% picture "portrait", { sizes: "(min-width: 1000px) calc((100vw - 208px) / 6 + 16px), 224px" } %}</div>
    <figcaption class="about-page__caption">{{ about.portraitNote }}</figcaption>
  </figure>

  <div class="frame about-page__square" data-part="card">{% picture "jellyfish" %}</div>
  <div class="frame about-page__strip" data-part="card">{% picture "swells" %}</div>

  <aside class="about__card about-page__elsewhere" aria-labelledby="elsewhere-label" data-part="card">
    <h2 class="about__label" id="elsewhere-label">{{ home.about.elsewhereLabel }}</h2>
    <ul class="icon-list">
      {%- for item in site.elsewhere %}
      <li class="icon-list__item">{{ icon(item.icon) }}<a class="icon-list__link" href="{{ item.url | fill | safe }}">{{ item.title | fill | safe }}</a></li>
      {%- endfor %}
    </ul>
  </aside>

  <section class="panel about-page__tinkering" data-part="card">
    <h2 class="panel__title">{{ about.tinkering.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in about.tinkering.paragraphs %}
      <p>{{ paragraph | fill | safe }}</p>
      {%- endfor %}
    </div>
  </section>

  {#- The newest post from the blog, built with the site and brought up to date by the page itself
      when the server knows of a newer one (assets/js/posts.js). Left out when the blog's feed
      could not be read during the build; the page can then add it. The blank copy in the
      <template> (a piece of the page that is never shown, only copied) marks where it goes, and
      is what a live one is made from, so it matches a built one exactly. #}
  {%- if blog.posts[0] %}
  {{- latestPost(blog.posts[0]) }}
  {%- endif %}
  <template data-latest-post-blank>{{ latestPost({ url: blog.url, isoDate: "", date: "", title: "", description: "-" }) }}</template>

  <section class="panel about-page__contact" data-part="card">
    <h2 class="panel__title">{{ about.contact.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in about.contact.paragraphs %}
      <p>{{ paragraph | fill | safe }}</p>
      {%- endfor %}
    </div>
    {#- The OpenPGP key, for encrypted email: its facts are read from the key file during the build
        (scripts/lib/pgp.mjs), so they always match the key offered for download. #}
    {%- set key = downloads.key.facts %}
    <div class="key">
      <h3 class="key__label">{{ about.contact.key.label }}</h3>
      <dl class="key__facts">
        <div><dt>{{ about.contact.key.fingerprint }}</dt><dd class="key__fingerprint">{{ key.fingerprint }}</dd></div>
        <div><dt>{{ about.contact.key.keyId }}</dt><dd>{{ key.keyId }}</dd></div>
        <div><dt>{{ about.contact.key.algorithm }}</dt><dd>{{ key.algorithm }}</dd></div>
        {%- if key.expires %}
        <div><dt>{{ about.contact.key.expires }}</dt><dd><time datetime="{{ key.expires }}">{{ key.expires }}</time></dd></div>
        {%- endif %}
      </dl>
      <a class="link key__download" href="{{ downloads.key.url }}" download data-taxi-ignore>{{ about.contact.key.download }}<span class="link__arrow" aria-hidden="true">&nearr;</span></a>
    </div>
    <a class="link panel__action" href="mailto:{{ site.email }}">{{ about.contact.link }}{{ arrow("mailto:") }}</a>
  </section>

  <section class="panel about-page__toolbox" data-part="card">
    <h2 class="panel__title">{{ about.toolbox.title }}</h2>
    {#- The roles keep this a table for screen readers on narrow windows, where the rows are stacked. #}
    <table class="fact-table" role="table">
      <thead role="rowgroup">
        <tr role="row">
          {%- for column in about.toolbox.columns %}
          <th role="columnheader" scope="col">{{ column }}</th>
          {%- endfor %}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {%- for row in about.toolbox.rows %}
        <tr role="row">
          {%- for cell in row %}
          <td role="cell">{{ cell }}</td>
          {%- endfor %}
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>

  {#- A closing thought in large serif letters. It echoes the "Who" card: learning more about the things you think you already know. #}
  <figure class="saying about-page__saying" data-part="card">
    <blockquote class="saying__text">
      <p>{{ about.quote.plain }} <i>{{ about.quote.italic }}</i></p>
    </blockquote>
    <figcaption class="saying__author">{{ about.quote.author }}</figcaption>
  </figure>
</div>
