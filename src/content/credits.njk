---
title: Credits
picture: theodoliterow
layout: layouts/page.njk
description: The people and services that helped make this site.
---
{#-
  The Credits page: four numbered cards. Their words are in _data/pages.json ("credits"); the
  photos come from _data/image-credits.json (as "pictureCredits": see eleventy.config.js).
  Each card is marked data-part="card": during a page change they arrive one after another.
-#}
<div class="page-grid" data-part="cards">
  <section class="panel page-grid__main" data-part="card">
    <h2 class="panel__title">{{ pages.credits.design.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in pages.credits.design.paragraphs %}
      <p>{{ paragraph | safe }}</p>
      {%- endfor %}
    </div>
  </section>

  <section class="panel page-grid__main" data-part="card">
    <h2 class="panel__title">{{ pages.credits.pictures.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in pages.credits.pictures.paragraphs %}
      <p>{{ paragraph | safe }}</p>
      {%- endfor %}
      <ul class="panel__list">
        {%- for picture in pictureCredits %}
        <li>{{ picture.subject | capitalize }}: <a href="{{ picture.url }}">{{ picture.title }}</a>, by {{ picture.photographer }}. {{ picture.collection }}, {{ picture.licence }}.</li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="panel page-grid__main" data-part="card">
    <h2 class="panel__title">{{ pages.credits.weather.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in pages.credits.weather.paragraphs %}
      <p>{{ paragraph | safe }}</p>
      {%- endfor %}
    </div>
  </section>

  <section class="panel page-grid__main" data-part="card">
    <h2 class="panel__title">{{ pages.credits.visits.title }}</h2>
    <div class="panel__text">
      {%- for paragraph in pages.credits.visits.paragraphs %}
      <p>{{ paragraph | safe }}</p>
      {%- endfor %}
    </div>
  </section>
</div>
