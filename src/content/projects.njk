---
title: Projects
picture: servers
layout: layouts/page.njk
pageKind: list
description: Things Romit Raj Sahu built, broke and rebuilt.
---
{#- The list of every project (the files in content/projects/): one wide card each, leading to that project's page. -#}
<ol class="project-cards" data-part="cards">
  {%- for item in collections.projectList %}
  {%- set project = item.data %}
  <li class="project-cards__item" data-part="card">
    <article class="project-card">
      <span class="project-card__number" aria-hidden="true">({{ "0" if loop.index < 10 }}{{ loop.index }})</span>
      <h2 class="project-card__title">{{ project.title }}</h2>
      <p class="project-card__text">{{ project.description }}</p>
      <div class="project-card__side">
        <dl class="project-card__facts">
          <div><dt class="visually-hidden">{{ pages.projects.tagsLabel }}</dt><dd>{{ project.tags | join(" | ") }}</dd></div>
          <div><dt class="visually-hidden">{{ pages.projects.yearLabel }}</dt><dd>{{ project.year }}</dd></div>
        </dl>
        <a class="project-card__more" href="{{ item.url }}"><span class="project-card__more-text">{{ pages.projects.readMore }}<span class="visually-hidden"> {{ pages.projects.readMoreAbout }} {{ project.title }}</span></span> <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>
  </li>
  {#- A picture frame beside every second card, shown on wide windows only. It shows that project's picture ("image" at the top of its file), or stays empty. #}
  {%- if loop.index % 2 == 0 %}
  <li class="frame project-cards__frame" data-part="card">{% if project.image %}{% picture project.image %}{% endif %}</li>
  {%- endif %}
  {%- endfor %}
</ol>
