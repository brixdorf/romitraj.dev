# Copy this file to .env and fill in the values. Never commit .env.

# Spotify keys for the now-playing widget (setup steps are in docs/guide.md).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional. Where the web fonts load from. Leave empty for the automatic choice.
FONT_BASE_URL=

# Optional. Port for npm start. Leave empty for 3000.
PORT=
